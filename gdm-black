#!/bin/bash
set -e

# Check privileges
[[ $EUID -eq 0 ]] || { echo "This script should be run with root privileges." >&2; exit 1; }

# Choose color
color="#000000"
case $1 in
    "")        ;;
    --color)   color="#${2#\#}" ;;
    --restore) color="#222226" ;;
    *)         echo "Usage: $0 [--color \"#RRGGBB\" | --color RRGGBB | --restore]" >&2
               exit 1 ;;
esac
[[ $color =~ ^#[0-9a-fA-F]{6}$ ]] || \
{ echo "Invalid color: $color (use \"#RRGGBB\" (with \"\") or RRGGBB)" >&2; exit 1; }

gst=/usr/share/gnome-shell/gnome-shell-theme.gresource
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

# Extract resources
for r in $(gresource list "$gst"); do
    f=$workdir/${r#/org/gnome/shell/}
    mkdir -p "$(dirname "$f")"
    gresource extract "$gst" "$r" > "$f"
done

# Generate gnome-shell-theme.gresource.xml
{
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' \
        '<gresources>' '  <gresource prefix="/org/gnome/shell/theme">'
    for f in "$workdir"/theme/*; do printf '    <file>%s</file>\n' "${f##*/}"; done
    printf '%s\n' '  </gresource>' '</gresources>'
} > "$workdir/gnome-shell-theme.gresource.xml"

# Set background color
sed -i "/#lockDialogGroup {/{n;s/#....../$color/;}" \
    $(grep -rlF '#lockDialogGroup' "$workdir/theme")

# Compile and install
glib-compile-resources --sourcedir="$workdir/theme" \
    --target="$workdir/new.gresource" "$workdir/gnome-shell-theme.gresource.xml"
cp "$workdir/new.gresource" "$gst"

echo "GDM background color is set to $color"
